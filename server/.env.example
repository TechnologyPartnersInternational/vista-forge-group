# Copy to server/.env for local development. In production, set these in the
# Vercel project settings (Settings -> Environment Variables).

PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

RESEND_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin portal login (checked server-side; never put these in VITE_* vars).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs out every admin session.
ADMIN_TOKEN_SECRET=
